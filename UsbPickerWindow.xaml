<Window x:Class="IsoForge.UsbPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gravar em pendrive" Icon="icon.ico"
        Width="720" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBg}">
    <StackPanel Margin="24">
        <TextBlock Text="Gravar o Windows personalizado em um pendrive" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock Foreground="{StaticResource TextMuted}" Margin="0,4,0,16" TextWrapping="Wrap"
                   Text="O pendrive é preparado para arrancar por UEFI (GPT + FAT32) e recebe os arquivos direto — sem passar por um arquivo .iso. Só aparecem aqui discos removíveis; o disco do sistema nunca é listado."/>

        <!-- Só discos removíveis chegam a esta lista: a filtragem é feita antes,
             no UsbWriter, e conferida de novo na hora de gravar. -->
        <ListBox x:Name="Lista" MaxHeight="220" Margin="0,0,0,4"
                 SelectionChanged="Lista_SelectionChanged"
                 AutomationProperties.Name="Pendrives disponíveis">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,6">
                        <TextBlock Text="{Binding Rotulo}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Barramento}" FontSize="11.5"
                                   Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Margin="0,4,0,14">
            <Button DockPanel.Dock="Right" Content="Atualizar lista" Style="{StaticResource Secondary}"
                    Padding="12,6" Click="Atualizar_Click"/>
            <TextBlock x:Name="TxtVazio" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMuted}" FontSize="12"/>
        </DockPanel>

        <!--
            Canal de erro de verdade. O TxtVazio acima e uma linha pequena e apagada ao lado
            de um botao: serve para "achei 2 discos", nao para explicar que o Windows negou
            acesso. Sem isto, falha de permissao e ausencia de pendrive liam igual.
        -->
        <Border x:Name="PainelFalha" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14"
                BorderBrush="{StaticResource WarnBorder}" Background="{StaticResource WarnBg}"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="TxtFalha" TextWrapping="Wrap" FontWeight="SemiBold"
                           Foreground="{StaticResource WarnText}"/>
                <TextBlock x:Name="TxtFalhaDetalhe" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11.5"
                           FontFamily="Consolas" Foreground="{StaticResource WarnText}"
                           Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnDetalhes" Content="Ver detalhes" Style="{StaticResource Secondary}"
                            Padding="10,5" Margin="0,0,8,0" Visibility="Collapsed" Click="Detalhes_Click"/>
                    <Button x:Name="BtnCopiar" Content="Copiar" Style="{StaticResource Secondary}"
                            Padding="10,5" Margin="0,0,8,0" Visibility="Collapsed" Click="Copiar_Click"/>
                    <Button x:Name="BtnElevarListar" Content="Tentar como administrador"
                            Style="{StaticResource Secondary}" Padding="10,5" Visibility="Collapsed"
                            Click="Elevar_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="AvisoApaga" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14"
                BorderBrush="{StaticResource CardBorder}" Background="{StaticResource CardBg}"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Isto apaga tudo o que está no pendrive" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtAlvo" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12.5"
                           Foreground="{StaticResource TextMuted}"/>
                <CheckBox x:Name="ChkConfirmo" Margin="0,10,0,0" Checked="Confirmo_Changed" Unchecked="Confirmo_Changed"
                          Content="Entendi: todo o conteúdo deste pendrive será apagado."/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="TxtAdmin" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="12.5"
                   Visibility="Collapsed"
                   Text="Gravar exige Administrador: particionar e formatar são operações privilegiadas. Ao clicar em Gravar no pendrive, o Windows vai pedir sua confirmação."/>

        <DockPanel>
            <Button DockPanel.Dock="Right" x:Name="BtnGravar" Content="Gravar no pendrive"
                    IsEnabled="False" Padding="18,9" Click="Gravar_Click"/>
            <Button DockPanel.Dock="Right" Content="Cancelar" Style="{StaticResource Secondary}"
                    Padding="18,9" Margin="0,0,10,0" Click="Cancelar_Click"/>
            <TextBlock/>
        </DockPanel>
    </StackPanel>
</Window>
