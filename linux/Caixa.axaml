<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IsoForge.Linux.Caixa"
        Title="IsoForge"
        Width="520" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource FundoCartao}">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- faixa de cor: azul para informação, vermelha para erro -->
    <Border Grid.Row="0" x:Name="Faixa" Height="4" Background="{StaticResource Destaque}"/>

    <StackPanel Grid.Row="1" Margin="26,22,26,18" Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock x:Name="Icone" Text="i" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource Destaque}" VerticalAlignment="Center"/>
        <TextBlock x:Name="Titulo" Classes="titulo" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </StackPanel>
      <SelectableTextBlock x:Name="Mensagem" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource TextoSecundario}" Margin="0,2,0,0"/>
    </StackPanel>

    <Border Grid.Row="2" Background="{StaticResource FundoSutil}"
            BorderBrush="{StaticResource BordaCartao}" BorderThickness="0,1,0,0" Padding="20,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button x:Name="BtSecundario" IsVisible="False"/>
        <Button x:Name="BtPrimario" Classes="primario" Content="OK" IsDefault="True"/>
      </StackPanel>
    </Border>

  </Grid>
</Window>
