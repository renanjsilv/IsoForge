<UserControl x:Class="IsoForge.SplashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             Background="Transparent"
             Focusable="True">

    <!--
        ============================================================================
        ABERTURA
        ============================================================================
        É uma CAMADA da janela principal, não outra janela. A escolha importa: o
        splash termina voando a marca até o lugar exato onde ela fica na tela
        seguinte. Em duas janelas isso seria um corte; aqui é um movimento só, e o
        app continua parecendo um programa único.

        A marca é o mesmo desenho do icon.ico, refeito em vetor para poder animar
        limpo em 132 px e encolher até 24 px sem serrilhar — e para os anéis
        entrarem em tempos diferentes, que é o que dá a sensação de "ligando".

        Fundo: o MESMO AmbientSurface da tela de escolha. Quando o splash sai, o
        fundo não muda — só o conteúdo por cima dele. É o que costura as duas telas.
    -->

    <Grid x:Name="Root" Background="Transparent">

        <Rectangle x:Name="Fundo" Fill="{DynamicResource WindowBg}"/>

        <Control x:Name="Backdrop" Style="{StaticResource AmbientSurface}"/>

        <!-- Vinheta: escurece as bordas para a marca ficar sozinha no centro
             visual, sem competir com os arcos do fundo. -->
        <Rectangle x:Name="Vinheta" IsHitTestVisible="False" Opacity="0.55">
            <Rectangle.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
                    <GradientStop Color="#00000000" Offset="0.15"/>
                    <GradientStop Color="#00000000" Offset="0.45"/>
                    <GradientStop Color="#22000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <StackPanel x:Name="Bloco" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- ================= MARCA + ANEL ================= -->
            <Grid Width="200" Height="200" HorizontalAlignment="Center">

                <!-- Trilho do anel: presença constante, quase sem peso. -->
                <Ellipse x:Name="Trilho" Width="184" Height="184"
                         Stroke="{DynamicResource CardBorder}" StrokeThickness="3" Opacity="0"/>

                <!-- Arco de 110 graus feito com traço interrompido: a Ellipse já
                     tem a caixa inteira como limite, então o giro roda em torno do
                     centro certo. Um Path com arco teria os limites da própria
                     curva e giraria torto.
                     Comprimento: 2*pi*92 = 578,05 px = 192,68 unidades de traço
                     (o traço mede em MÚLTIPLOS da espessura). 110 graus = 58,87. -->
                <Ellipse x:Name="Arco" Width="184" Height="184" StrokeThickness="3"
                         StrokeDashArray="58.87 133.81" StrokeDashCap="Round"
                         Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B82F6" Offset="0"/>
                            <GradientStop Color="#60A5FA" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="ArcoGiro" Angle="-90"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- A marca. O Viewbox permite mudar UM número (a largura) e ter
                     tudo proporcional; o voo final só mexe em escala e posição. -->
                <Viewbox x:Name="Marca" Width="132" Height="132" Opacity="0"
                         RenderTransformOrigin="0.5,0.5">
                    <Viewbox.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="MarcaEscala" ScaleX="0.86" ScaleY="0.86"/>
                            <TranslateTransform x:Name="MarcaVoo"/>
                        </TransformGroup>
                    </Viewbox.RenderTransform>

                    <Canvas Width="128" Height="128">
                        <!-- pastilha -->
                        <Border Width="128" Height="128" CornerRadius="28">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4C8DF6" Offset="0"/>
                                    <GradientStop Color="#1D4ED8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- disco -->
                        <Ellipse x:Name="Disco" Canvas.Left="22" Canvas.Top="25" Width="78" Height="78" Fill="White"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="DiscoEscala" ScaleX="0.2" ScaleY="0.2"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- trilha -->
                        <Ellipse x:Name="Trilha" Canvas.Left="32" Canvas.Top="35" Width="58" Height="58"
                                 Stroke="#2563EB" StrokeThickness="5" Opacity="0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="TrilhaEscala" ScaleX="0.55" ScaleY="0.55"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- cubo -->
                        <Ellipse x:Name="Cubo" Canvas.Left="46" Canvas.Top="49" Width="30" Height="30" Fill="#1D4ED8" Opacity="0"/>
                        <Ellipse x:Name="Furo" Canvas.Left="55" Canvas.Top="58" Width="12" Height="12" Fill="White" Opacity="0"/>

                        <!-- faísca: o acento da marca, e a última coisa a entrar -->
                        <Canvas Canvas.Left="79" Canvas.Top="19">   <!-- 94,34 menos o raio: e o canto do desenho que ancora -->
                            <Path x:Name="Faisca" Opacity="0" RenderTransformOrigin="0.5,0.5"
                                  Data="M 0,-15 C 1.7,-5.4 5.4,-1.7 15,0 C 5.4,1.7 1.7,5.4 0,15 C -1.7,5.4 -5.4,1.7 -15,0 C -5.4,-1.7 -1.7,-5.4 0,-15 Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FCD34D" Offset="0"/>
                                        <GradientStop Color="#F59E0B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="FaiscaEscala" ScaleX="0" ScaleY="0"/>
                                        <RotateTransform x:Name="FaiscaGiro" Angle="-60"/>
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                        </Canvas>
                    </Canvas>
                </Viewbox>
            </Grid>

            <!-- ================= ASSINATURA ================= -->
            <TextBlock x:Name="Wordmark" HorizontalAlignment="Center" Margin="0,4,0,0"
                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="42" FontWeight="Bold"
                       Opacity="0" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform><TranslateTransform x:Name="WordmarkSobe" Y="14"/></TextBlock.RenderTransform>
                <Run Text="Iso" Foreground="{DynamicResource TextMain}"/><Run x:Name="RunForge" Text="Forge" Foreground="{DynamicResource AccentText}"/>
            </TextBlock>

            <TextBlock x:Name="Tagline" HorizontalAlignment="Center" Margin="0,6,0,0"
                       Text="Estúdio de imagens de instalação" Opacity="0"
                       FontFamily="Segoe UI Variable, Segoe UI" FontSize="13.5"
                       Foreground="{DynamicResource TextSecondary}"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform><TranslateTransform x:Name="TaglineSobe" Y="10"/></TextBlock.RenderTransform>
            </TextBlock>
        </StackPanel>

        <!-- Rodapé discreto: versão e a saída. Quem já viu a abertura dez vezes
             não quer vê-la de novo — clicar ou apertar qualquer tecla corta. -->
        <StackPanel x:Name="Rodape" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,26" Opacity="0">
            <TextBlock x:Name="TxtVersao" HorizontalAlignment="Center" FontSize="11.5"
                       Foreground="{DynamicResource TextDisabled}" Text="v1.0.0"/>
            <TextBlock HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"
                       Foreground="{DynamicResource TextDisabled}" Text="clique para pular"/>
        </StackPanel>
    </Grid>
</UserControl>
