<Window x:Class="IsoForge.Caixa"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IsoForge" Icon="icon.ico"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}">
    <!-- A caixa de diálogo do IsoForge.
         Existe porque o MessageBox do Windows não acompanha o tema do aplicativo: no
         tema escuro ele aparecia branco, com a fonte e o espaçamento do sistema, e
         parecia outro programa. Aqui a estrutura é sempre a mesma — glifo, título,
         texto, detalhe opcional e os botões à direita. -->
    <Grid Margin="26,24,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- O glifo vai num TextBlock com FontFamily PRÓPRIA: o estilo implícito de
             TextBlock define a fonte e venceria a herdada, virando um quadrado vazio. -->
        <Border Grid.Row="0" Grid.Column="0" Width="42" Height="42" CornerRadius="12"
                Background="{DynamicResource OsAccentSoft}" VerticalAlignment="Top" Margin="0,2,16,0">
            <TextBlock x:Name="Glifo" FontFamily="Segoe MDL2 Assets" FontSize="20"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource OsAccentText}" Text="&#xE946;"/>
        </Border>

        <StackPanel Grid.Row="0" Grid.Column="1">
            <TextBlock x:Name="Titulo" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMain}"/>
            <TextBlock x:Name="Mensagem" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="13.5"
                       Foreground="{DynamicResource TextMuted}"/>
        </StackPanel>

        <!-- Detalhe recolhido: mensagem de erro longa não pode empurrar os botões para
             fora da tela, mas também não pode sumir. -->
        <Expander x:Name="PainelDetalhe" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0"
                  Header="Detalhes" Visibility="Collapsed">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                <TextBox x:Name="Detalhe" IsReadOnly="True" TextWrapping="Wrap"
                         BorderThickness="0" Background="Transparent" FontSize="12.5"
                         FontFamily="Cascadia Mono, Consolas"
                         Foreground="{DynamicResource TextSecondary}"/>
            </ScrollViewer>
        </Expander>

        <StackPanel x:Name="Botoes" Grid.Row="2" Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,22,0,0"/>
    </Grid>
</Window>
