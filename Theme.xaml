    <!-- Storyboard do fundo. Períodos: 120 / 60 / 40 (rotações) e 30 / 20 / 15 / 12
         com AutoReverse (ciclo 60 / 40 / 30 / 24). Todos dividem 120 s. -->
    <!-- ============================================================
         FUNDO DA BARRA LATERAL
         ============================================================
         A barra e a unica superficie do app que ficava parada, e e a que o usuario
         mais olha (esta em todas as telas). Aqui ela ganha vida sem virar distracao:

           · FAIXAS: aneis gigantes tracejados girando fora da barra, dos quais so
             uma fatia cruza a coluna — e o MESMO gesto do fundo das demais telas,
             para a barra nao parecer de outro app;
           · dois CLAROES largos e translucidos que derivam devagar — dao a
             sensacao de profundidade e sao o que se ve pelo canto do olho;
           · BRASAS subindo, na cor do sistema escolhido: 16 pontos de 2,5 a 7 px
             que sobem em 15 a 34 s, cada um com atraso proprio. E o gesto que
             batiza o produto (uma forja solta brasas) e custa quase nada — a area
             pintada por quadro e de algumas centenas de pixels.

         Cor: {DynamicResource SidebarAccent}, que o OsAccentService ja escreve por
         sistema na variante "acesa" (luminancia >= 0,32). Nao ha ColorAnimation
         aqui: quando o sistema muda, a entrada do dicionario muda e os elementos
         re-resolvem sozinhos.

         Custo: 60 fps como o resto do app, e barato por construcao — 232 px de
         largura contra a janela inteira do fundo principal. As faixas usam o mesmo
         BitmapCache a 0,5x (ver AmbientSb). E, como todo fundo do app, o relogio e
         PARADO quando a janela vai para segundo plano ou quando a camada de escolha
         esta por cima (MainWindow.LigarFundoDaBarra).
         ============================================================ -->
    <ControlTemplate x:Key="SidebarBackdrop" TargetType="Control">
        <Grid ClipToBounds="True">

            <!-- FAIXAS: o mesmo gesto do fundo das demais telas, em escala de coluna.
                 Aneis gigantes centrados FORA da barra, a esquerda: so uma fatia
                 cruza os 232 px, e girar essa fatia le como uma banda descendo. O
                 tracejado e o que impede um anel uniforme de girar sem que nada
                 pareca mudar (mesmo truque do AmbientBackdrop). -->
            <Canvas Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-150,0,0,0">
                <Canvas.CacheMode><BitmapCache RenderAtScale="0.5" EnableClearType="False"/></Canvas.CacheMode>
                <Canvas.RenderTransform><RotateTransform x:Name="FxA" Angle="0"/></Canvas.RenderTransform>
                <Ellipse Canvas.Left="-520" Canvas.Top="-520" Width="1040" Height="1040"
                         Stroke="{TemplateBinding Foreground}" StrokeThickness="170" Opacity="{DynamicResource SidebarBandA}"
                         StrokeDashArray="3.2 4.4" StrokeDashCap="Round"/>
            </Canvas>

            <Canvas Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-60,0,0,120">
                <Canvas.CacheMode><BitmapCache RenderAtScale="0.5" EnableClearType="False"/></Canvas.CacheMode>
                <Canvas.RenderTransform><RotateTransform x:Name="FxB" Angle="0"/></Canvas.RenderTransform>
                <Ellipse Canvas.Left="-360" Canvas.Top="-360" Width="720" Height="720"
                         Stroke="{TemplateBinding Foreground}" StrokeThickness="110" Opacity="{DynamicResource SidebarBandB}"
                         StrokeDashArray="3.8 5.6" StrokeDashCap="Round"/>
            </Canvas>

            <!-- fio pontilhado: o movimento de detalhe, que e o que denuncia que a
                 superficie inteira esta viva mesmo quando as bandas estao lentas -->
            <Canvas Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-200,0,0,-80">
                <Canvas.CacheMode><BitmapCache RenderAtScale="0.5" EnableClearType="False"/></Canvas.CacheMode>
                <Canvas.RenderTransform><RotateTransform x:Name="FxC" Angle="0"/></Canvas.RenderTransform>
                <Ellipse Canvas.Left="-610" Canvas.Top="-610" Width="1220" Height="1220"
                         Stroke="{TemplateBinding Foreground}" StrokeThickness="2.4" Opacity="{DynamicResource SidebarBandFio}"
                         StrokeDashArray="0.6 10" StrokeDashCap="Round"/>
                <Ellipse Canvas.Left="-470" Canvas.Top="-470" Width="940" Height="940"
                         Stroke="{TemplateBinding Foreground}" StrokeThickness="2" Opacity="0.34"
                         StrokeDashArray="0.7 14" StrokeDashCap="Round"/>
            </Canvas>

            <!-- claroes -->
            <Ellipse x:Name="ClarA" Width="300" Height="440" Opacity="0.28"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-110,-60,0,0"
                     Fill="{DynamicResource SidebarGlowA}">
                <Ellipse.RenderTransform><TranslateTransform x:Name="ClarAT"/></Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse x:Name="ClarB" Width="340" Height="520" Opacity="0.32"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-140,-90"
                     Fill="{DynamicResource SidebarGlowB}">
                <Ellipse.RenderTransform><TranslateTransform x:Name="ClarBT"/></Ellipse.RenderTransform>
            </Ellipse>

            <!-- VELA. Os itens INATIVOS do menu usam SidebarTextMuted, e medido
                 sobre a banda mais clara ele caia para 3,90:1. Aqui as faixas
                 continuam passando, mas amortecidas atras do texto: a mesma regra
                 da tela de escolha — nenhum texto fica direto sobre o fundo vivo.
                 Altura FIXA, nao fracao: o que ela protege (marca + 6 itens) tem
                 altura fixa, e em fracao ela deixaria o menu de fora a 900 px. -->
            <Rectangle Height="470" VerticalAlignment="Top" IsHitTestVisible="False"
                       Fill="{DynamicResource SidebarScrimTop}"/>

            <!-- idem no pe, pela versao e o link -->
