    <!-- 60 fps, e nao 15. O custo aqui e TAXA DE PREENCHIMENTO: uma dezena de
         formas translucidas gigantes recompostas sobre a janela inteira. Nao e
         anti-aliasing (testado: EdgeMode=Aliased nao muda nada) e nao adianta
         esconder o Control (o WPF continua avaliando as animacoes).

         A conta que importa (i5-1135G7 + Iris Xe, 1920x1080, janela maximizada na
         tela de escolha, mediana de 5 execucoes):

             15 fps ............................ 47%  — fluido nao, PASSO visivel
             60 fps sem cache .................. 82%, com picos em 100%
             60 fps com BitmapCache a 0,5x ..... 47%, estavel (45,9-51,0)

         A leitura do "sem cache" e o ponto: saturando um nucleo, o WPF PERDE
         quadros, e perder quadro irregular parece pior do que passo regular. Por
         isso a resposta a "quero 60 fps fluido" nao foi so mudar o numero — foi
         baratear o desenho ate 60 fps caber.

         BitmapCache serve exatamente a este caso: o que anima e SO a transformacao
         de cada camada, entao o WPF rasteriza a geometria uma vez e passa a
         transformar a textura. RenderAtScale=0,5 corta a textura a um quarto da
         memoria (233 MB -> 362 MB de working set; a 1,0x ia a 725 MB) e e
         invisivel: sao arcos borrados a 8-11% de opacidade — comparado quadro a
         quadro contra o render sem cache, nao ha diferenca.

         Em segundo plano o relogio continua sendo PARADO
         (MainWindow.PausarTodosOsFundos), que leva o custo a ~1%. -->
    <Storyboard x:Key="AmbientSb" Timeline.DesiredFrameRate="60">
        <DoubleAnimation Storyboard.TargetName="TrackA" Storyboard.TargetProperty="Angle"
                         From="0" To="360" Duration="0:2:00" RepeatBehavior="Forever"/>
        <DoubleAnimation Storyboard.TargetName="TrackB" Storyboard.TargetProperty="Angle"
                         From="0" To="-360" Duration="0:1:00" RepeatBehavior="Forever"/>
        <DoubleAnimation Storyboard.TargetName="TrackC" Storyboard.TargetProperty="Angle"
                         From="0" To="-360" Duration="0:0:40" RepeatBehavior="Forever"/>

        <DoubleAnimation Storyboard.TargetName="DriftL" Storyboard.TargetProperty="X"
                         From="-26" To="34" Duration="0:0:30" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetName="DriftL" Storyboard.TargetProperty="Y"
                         From="18" To="-22" Duration="0:0:20" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetName="DriftR" Storyboard.TargetProperty="X"
                         From="22" To="-30" Duration="0:0:15" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>

        <DoubleAnimation Storyboard.TargetName="WashAT" Storyboard.TargetProperty="X"
                         From="-70" To="90" Duration="0:0:30" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetName="WashAT" Storyboard.TargetProperty="Y"
                         From="-50" To="70" Duration="0:0:20" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetName="WashAS" Storyboard.TargetProperty="ScaleX"
                         From="0.9" To="1.16" Duration="0:0:15" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetName="WashAS" Storyboard.TargetProperty="ScaleY"
                         From="1.12" To="0.92" Duration="0:0:20" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetName="WashBT" Storyboard.TargetProperty="X"
                         From="60" To="-80" Duration="0:0:20" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetName="WashBT" Storyboard.TargetProperty="Y"
                         From="40" To="-60" Duration="0:0:15" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetName="WashBS" Storyboard.TargetProperty="ScaleX"
                         From="1.14" To="0.9" Duration="0:0:12" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetName="WashBS" Storyboard.TargetProperty="ScaleY"
                         From="0.92" To="1.18" Duration="0:0:20" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- ============================================================
         CARD DE APLICATIVO (ToggleButton selecionável)
         ============================================================ -->
    <Style x:Key="AppCard" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <!-- 214, nao 196: com 196 sobravam 106 px para o nome e "Google Chrome"
             saia como "Google Chro..." mesmo com a linha inteira vazia a direita. -->
        <Setter Property="Width" Value="214"/>
        <Setter Property="Height" Value="96"/>
        <Setter Property="Margin" Value="0,0,14,14"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="shadow" CornerRadius="16" Background="#FFFFFF" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#3B82F6" BlurRadius="22" ShadowDepth="0" Opacity="0.28"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="bg" CornerRadius="16" Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1.5"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="iconWrap" Grid.Column="0" Width="46" Height="46" CornerRadius="12"
                                        Background="{DynamicResource OsAccentSoft}" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="icon" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="21" Foreground="{DynamicResource OsAccentText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <TextBlock x:Name="sub" Text="Clique para incluir" FontSize="11.5"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="NoWrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- selo de selecionado -->
                        <Border x:Name="check" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource OsAccentGradient}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-7,0"
                                RenderTransformOrigin="0.5,0.5" Opacity="0">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="cksc" ScaleX="0.4" ScaleY="0.4"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource OsAccentColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource OsAccent}"/>
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource OsAccentSoft}"/>
                            <Setter TargetName="iconWrap" Property="Background" Value="{DynamicResource OsAccentGradient}"/>
                            <Setter TargetName="icon" Property="Foreground" Value="White"/>
                            <Setter TargetName="sub" Property="Text" Value="Incluído ✓"/>
                            <Setter TargetName="sub" Property="Foreground" Value="{DynamicResource OsAccentText}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="check" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="cksc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.32">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.7" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="cksc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.32">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.7" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="check" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="cksc" Storyboard.TargetProperty="ScaleX" To="0.4" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="cksc" Storyboard.TargetProperty="ScaleY" To="0.4" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chip de app selecionado (mostra o que está incluído + botão remover) -->
    <Style x:Key="AppChipRemove" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="9" Background="{DynamicResource OsAccent}"
                            SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Grid>
                            <!-- VEU DE ESTADO. O hover era um ColorAnimation com "#1D4ED8"
                                 e o pressed com "#1E40AF": tres hex que nao seguem nem o
                                 tema nem o sistema escolhido. Um veu preto so ESCURECE,
                                 entao o branco do rotulo nunca perde contraste, seja qual
                                 for a marca por baixo. (#000000 aqui nao e cor de tema:
                                 e sombra.) -->
                            <Border x:Name="veil" CornerRadius="9" Background="#000000" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="veil" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="veil" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="veil" Storyboard.TargetProperty="Opacity" To="0.26" Duration="0:0:0.05"/>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0:0:0.05"/>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0:0:0.05"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource InputDisabledBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmento (RadioButton em forma de pílula, p/ Online/Offline etc.) -->
    <!-- ================================================================
         SEGMENTADO
         Era um punhado de botoes soltos com 8px de folga entre eles: lia como
         tres botoes independentes, nao como UMA escolha entre tres. Agora as
         opcoes vivem dentro de uma trilha (SegmentTrack) e a opcao ativa e a
         unica com superficie — o padrao de segmented control.
         ================================================================ -->
    <Style x:Key="SegmentTrack" TargetType="ItemsControl">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusMd}" Padding="3">
                        <StackPanel Orientation="Horizontal" IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" CornerRadius="{StaticResource RadiusSm}" Padding="15,7"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                        </Trigger>
                        <!-- A opcao ESCOLHIDA tinha o texto de MENOR contraste do controle
                             (6,7:1 no claro e 7,2:1 no escuro, contra ~16:1 das nao
                             escolhidas): o acento colorido pesa menos que o texto normal.
                             Agora o texto vai no contraste cheio e quem marca a escolha e a
                             borda de acento — que tambem nao depende so de cor: a pilula
                             sobe do trilho e o peso da fonte aumenta. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource CardBg}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMain}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

