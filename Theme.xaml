<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:ui="clr-namespace:IsoForge.Ui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         PALETA
         ============================================================ -->
    <Color x:Key="AccentColor">#2563EB</Color>
    <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#1E40AF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="WindowBg" Color="#F1F4FB"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#E5EAF3"/>
    <SolidColorBrush x:Key="InputBorder" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TextMain" Color="#0F172A"/>
    <!-- #64748B media 4,37:1 sobre WindowBg — reprovava AA em texto pequeno.
         #556076 mede 5,59:1 no pior fundo claro e 6,32:1 sobre cartão branco. -->
    <SolidColorBrush x:Key="TextMuted" Color="#556076"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#0B1220"/>
    <SolidColorBrush x:Key="Danger" Color="#DC2626"/>
    <SolidColorBrush x:Key="Success" Color="#16A34A"/>
    <!-- Caixas de aviso (âmbar) e informação (azul) — temáveis pelo ThemeService -->
    <SolidColorBrush x:Key="WarnBg" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="WarnBorder" Color="#FCD34D"/>
    <SolidColorBrush x:Key="WarnText" Color="#92400E"/>
    <SolidColorBrush x:Key="InfoBg" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="InfoBorder" Color="#BFDBFE"/>
    <SolidColorBrush x:Key="InfoText" Color="#1E3A8A"/>
    <SolidColorBrush x:Key="ChipBg" Color="#F1F5F9"/>
    <!-- Superfícies sutis: fundo de input desabilitado e caixas internas -->
    <SolidColorBrush x:Key="InputDisabledBg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SubtleBg" Color="#F8FAFC"/>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0"/>
        <GradientStop Color="#6366F1" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0B1220" Offset="0"/>
        <GradientStop Color="#101A30" Offset="0.6"/>
        <GradientStop Color="#131E38" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3B82F6" Offset="0"/>
        <GradientStop Color="#8B5CF6" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============================================================
         ACENTO DO SISTEMA ESCOLHIDO
         ============================================================
         Os valores aqui sao o PADRAO (o azul do IsoForge). Em runtime,
         OsAccentService.Apply(os, escuro) troca as entradas pela marca do
         sistema escolhido, derivadas de OsInfo.Accent com contraste MEDIDO.

         Sempre por {DynamicResource}: {StaticResource} congela no parse e o
         controle ficaria azul para sempre.

         O ThemeService NAO escreve estas chaves. Quem troca o tema chama
         ThemeService.Apply e DEPOIS OsAccentService.Apply — senao a troca de
         tema apagaria a marca do sistema.
         ============================================================ -->
    <Color x:Key="OsAccentColor">#2563EB</Color>
    <SolidColorBrush x:Key="OsAccent"     Color="#2563EB"/>
    <SolidColorBrush x:Key="OsAccentText" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="OsAccentSoft" Color="#242563EB"/>
    <LinearGradientBrush x:Key="OsAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#4B87F5" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="OsAccentWash" GradientOrigin="0,0" Center="0,0" RadiusX="0.8" RadiusY="1.6">
        <GradientStop Color="#141D4ED8" Offset="0"/>
        <GradientStop Color="#001D4ED8" Offset="1"/>
    </RadialGradientBrush>

    <!--
    ================================================================================
    LINGUAGEM VISUAL v2 — TOKENS COMPARTILHADOS POR TODAS AS TELAS
    ================================================================================
    Regras de uso (valem para OsSelectionWindow, MainWindow e qualquer tela nova):

      1. ESPAÇAMENTO só sai da escala de 4 px (Space1..Space6). Nada de "Margin=13".
      2. RAIO só sai de RadiusSm..RadiusPill.
      3. TEXTO só usa os estilos de tipografia daqui (TitleScreen, TitleSection,
         BodyText, LabelText, CaptionText, ValueText, LaneLabel).
         >>> NUNCA aplique Opacity em texto. <<< Opacity dilui o contraste de forma
         invisível para quem escreve o XAML: se precisa de um cinza mais fraco,
         troque o ESTILO (o token já vem com contraste medido), não a opacidade.
      4. Cor que muda com o tema SEMPRE por {DynamicResource}. Todo token novo
         daqui está espelhado nos DOIS ramos de ThemeService.Apply.
      5. Superfícies: SurfaceCard (cartão), SurfaceRail (barra fixa),
         SurfacePlate (placa atrás de texto que fica sobre o fundo animado).
      6. Fundo animado: <Control Style="{StaticResource AmbientSurface}"/> —
         ver comentário do AmbientBackdrop mais abaixo.

    Contrastes MEDIDOS no pixel (glifo vs. fundo local, tela renderizada):
      TextMain      17.2:1   TextSecondary  9.1:1   TextMuted  5.8:1
      TextMuted sobre ChipBg 5.8:1          TextMuted sobre SurfaceRaised 6.1:1
      (o antigo TextMuted #64748B media 4.4:1 e foi trocado por #556076)

    INVENTÁRIO (o que existe para reaproveitar)
    ..............................................................................
    Espaçamento : Space1..Space6 · PagePad · PageGutter · CardPad · RailPad · StackGap
    Raio        : RadiusSm · RadiusMd · RadiusLg · RadiusXl · RadiusPill
    Texto       : TitleScreen · TitleSection · LaneLabel · BodyText · ValueText
                  LabelText · CaptionText
    Cor de texto: TextMain · TextSecondary · TextMuted · OnAccent
    Superfície  : SurfaceRaised (barra fixa) · SurfaceGlass (cartão translúcido)
                  SurfaceHover · SurfaceScrim (placa) · Elevation (relevo/sombra)
                  AppSurfaceGradient (fundo de página)
    Estado      : HoverRing (neutro) · FocusRing · Elevation
    Estilos     : SurfaceCard · SurfaceRail · SurfacePlate · Chip · AmbientSurface
    Fundo vivo  : AmbientBackdrop (ControlTemplate) + AmbientSb (Storyboard)
                  AmbientLine · AmbientDot
    ..............................................................................
    Estilos ANTIGOS preservados sem mudança de API: Cta, Secondary, Segment,
    AppCard, AppChipRemove, TabPage e todos os brushes originais.
    ================================================================================ -->

    <!-- ~~~ ESPAÇAMENTO (escala de 4 px) ~~~ -->
    <sys:Double x:Key="Space1">4</sys:Double>
    <sys:Double x:Key="Space2">8</sys:Double>
    <sys:Double x:Key="Space3">14</sys:Double>
    <sys:Double x:Key="Space4">20</sys:Double>
    <sys:Double x:Key="Space5">28</sys:Double>
    <sys:Double x:Key="Space6">40</sys:Double>
    <!-- Margens compostas prontas: a MESMA margem lateral em todas as faixas de
         uma tela é o que faz as metades se alinharem. -->
    <Thickness x:Key="PagePad">34,24,34,20</Thickness>
    <Thickness x:Key="PageGutter">34,0,34,0</Thickness>
    <Thickness x:Key="CardPad">16,13,16,13</Thickness>
    <Thickness x:Key="RailPad">34,15,34,15</Thickness>
    <Thickness x:Key="StackGap">0,0,0,14</Thickness>

    <!-- ~~~ RAIO ~~~ -->
    <CornerRadius x:Key="RadiusSm">8</CornerRadius>
    <CornerRadius x:Key="RadiusMd">12</CornerRadius>
    <CornerRadius x:Key="RadiusLg">16</CornerRadius>
    <CornerRadius x:Key="RadiusXl">22</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- ~~~ SUPERFÍCIES E TEXTO (temáveis) ~~~
         Todos espelhados em ThemeService.Apply. Os valores aqui são o tema CLARO. -->
    <SolidColorBrush x:Key="TextSecondary" Color="#334155"/>   <!-- corpo de texto -->
    <SolidColorBrush x:Key="SurfaceRaised" Color="#F0FBFCFE"/> <!-- barras fixas   -->
    <SolidColorBrush x:Key="SurfaceHover"  Color="#F0E9F0FB"/> <!-- hover neutro   -->
    <SolidColorBrush x:Key="SurfaceScrim"  Color="#CCF1F5FC"/> <!-- placa de texto -->
    <SolidColorBrush x:Key="Elevation"     Color="#1A0B1220"/> <!-- sombra/relevo  -->
    <SolidColorBrush x:Key="FocusRing"     Color="#2563EB"/>   <!-- foco de teclado-->
    <!-- Anel de hover NEUTRO: a mesma força visual em qualquer marca. O anel de
         seleção usa a cor da marca normalizada e é mais grosso, então seleção
         sempre grita mais alto que hover. -->
    <SolidColorBrush x:Key="HoverRing"     Color="#94A3BC"/>
    <SolidColorBrush x:Key="OnAccent"      Color="#FFFFFF"/>
    <!-- Accent aplicado em TEXTO/ÍCONE sobre superfície (não em botão preenchido).
         O Accent puro (#2563EB) mede 2,7:1 sobre o cartão escuro — reprovava.
         Este token é o azul JÁ ajustado ao tema: 6,3:1 no claro, 8,4:1 no escuro. -->
    <SolidColorBrush x:Key="AccentText"    Color="#1D4ED8"/>
    <!-- Superfície "vidro": cartão que deixa o fundo animado passar por baixo.
         Alfa escolhido para o texto continuar acima de 12:1 mesmo com um arco
         cruzando o cartão (medido). É o que faz a tela INTEIRA se mexer, em vez
         de só as frestas entre os cartões. -->
    <SolidColorBrush x:Key="SurfaceGlass"  Color="#D8FFFFFF"/>
    <!-- Fundo animado: linha e ponto neutros -->
    <SolidColorBrush x:Key="AmbientLine"   Color="#2E1B3A66"/>
    <SolidColorBrush x:Key="AmbientDot"    Color="#4D1B3A66"/>
    <!-- Superfície REBAIXADA (console de atividade): o oposto de SurfaceRaised.
         O log era "#0B1220" cravado no XAML — preto no tema claro. Agora é um
         token: recuado nos dois temas, com o texto sempre em TextSecondary. -->
    <SolidColorBrush x:Key="SurfaceSunken" Color="#E6ECF8"/>
    <!-- Texto de controle desabilitado. Existe para NÃO usar Opacity em texto:
         Opacity=0.45 sobre 4,5:1 derruba para ~2:1 sem ninguém perceber. -->
    <SolidColorBrush x:Key="TextDisabled"  Color="#7C879B"/>
    <!-- Verde de "tudo certo" (ponto do console). Era #22C55E cravado no XAML. -->
    <SolidColorBrush x:Key="Ok"            Color="#15803D"/>

    <!-- ~~~ TEXTO DA SIDEBAR (NÃO temável) ~~~
         A sidebar tem tokens PROPRIOS porque e uma superficie separada — mais
         funda que a pagina nos dois temas, mas do mesmo mundo. Por isso ela
         não pode usar os tokens de página: TextMain é quase preto no tema claro
         e o item selecionado sumiria no fundo escuro. Contraste medido sobre o
         gradiente (#0F172A..#1E293B): 12,7:1 / 6,8:1 / 7,4:1. -->
    <SolidColorBrush x:Key="SidebarText"      Color="#E6EDF6"/>
    <SolidColorBrush x:Key="SidebarTextMuted" Color="#9FB0C6"/>
    <SolidColorBrush x:Key="SidebarAccent"    Color="#7FB0FF"/>
    <!-- Pílula do item ativo e do hover. Pelo mesmo motivo do texto: AccentSoft e
         SurfaceHover são claros (feitos para superfície de página) e viravam uma
         pastilha branca com texto branco em cima. Aqui são véus translúcidos sobre
         o gradiente escuro: o resultado fica ~#2A3F5D, com o texto a ~11:1. -->
    <SolidColorBrush x:Key="SidebarActiveBg"  Color="#2E60A5FA"/>
    <SolidColorBrush x:Key="SidebarHoverBg"   Color="#16FFFFFF"/>
    <!-- Fio que separa a sidebar do conteudo. Sem ele, no tema escuro a coluna
         some contra o fundo da pagina (medido: 1,15:1) e a estrutura da janela
         desaparece justamente no tema em que ela mais importa. -->
    <SolidColorBrush x:Key="SidebarEdge"      Color="#4DFFFFFF"/>
    <!-- Opacidade das faixas, por tema. Uma cor saturada translucida tinge MUITO
         mais um fundo claro que um escuro: com o carmim do Debian, a 11% o texto
         secundario da barra media 3,92:1 no tema claro. Valores padrao = escuro;
         ThemeService.BarraLateral reescreve. -->
    <sys:Double x:Key="SidebarBandA">0.115</sys:Double>
    <sys:Double x:Key="SidebarBandB">0.090</sys:Double>
    <sys:Double x:Key="SidebarBandFio">0.40</sys:Double>
    <!-- Realce e vela do fundo animado da barra. INVERTEM com o tema: no claro,
         escurecer atras de texto escuro pioraria o contraste — quem protege ali e
         o branco. Os valores aqui sao o padrao (escuro); ThemeService.BarraLateral
         reescreve os dois. -->
    <RadialGradientBrush x:Key="SidebarGlowA">
        <GradientStop Color="#33FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="SidebarGlowB">
        <GradientStop Color="#59FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="SidebarScrimTop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B8000000" Offset="0"/>
        <GradientStop Color="#A0000000" Offset="0.62"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SidebarScrimBottom" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#A0000000" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- Fundo de página (as três paradas mudam com o tema — trocadas inteiras
         por ThemeService.SetBrush). Use como Background da janela/raiz. -->
    <LinearGradientBrush x:Key="AppSurfaceGradient" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#F7F9FE" Offset="0"/>
        <GradientStop Color="#E9EFFA" Offset="0.55"/>
        <GradientStop Color="#F4F7FD" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============================================================
         TIPOGRAFIA — contraste já verificado; não use Opacity em texto
         ============================================================ -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="TitleScreen" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="LineHeight" Value="37"/>
    </Style>
    <Style x:Key="TitleSection" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
    </Style>
    <!-- Rótulo de faixa/seção em caixa alta (o texto já vem em maiúsculas) -->
    <Style x:Key="LaneLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="LineHeight" Value="19"/>
    </Style>
    <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- ============================================================
         SUPERFÍCIES GENÉRICAS
         ============================================================ -->
    <Style x:Key="SurfaceCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
        <Setter Property="Padding" Value="{StaticResource CardPad}"/>
    </Style>
    <!-- Barra fixa (topo/rodapé). O fio de 1 px vai de borda a borda: barra
         parcial deixa "fio órfão" no meio da janela. -->
    <Style x:Key="SurfaceRail" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="{StaticResource RailPad}"/>
    </Style>
    <!-- Placa atrás de texto que vive SOBRE o fundo animado: garante que o
         contraste do texto não dependa do que estiver passando atrás. -->
    <Style x:Key="SurfacePlate" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceScrim}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ChipBg}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
        <Setter Property="Padding" Value="11,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Barra fixa do TOPO: mesmo pincel/padding do SurfaceRail, fio embaixo.
         Existe para o fio do topo e o da lateral se encontrarem no mesmo pixel. -->
    <Style x:Key="SurfaceRailTop" TargetType="Border" BasedOn="{StaticResource SurfaceRail}">
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <!-- Console de atividade: superfície REBAIXADA (não é um retângulo preto). -->
    <Style x:Key="SurfaceConsole" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
    </Style>

    <!--
    ================================================================================
    FUNDO ANIMADO REUTILIZÁVEL — "trilhas"
    ================================================================================
    Uso mínimo (qualquer janela):

        <Grid>
            <Control x:Name="Backdrop" Style="{StaticResource AmbientSurface}"/>
            ... conteúdo ...
        </Grid>

    e no code-behind, para ligar o movimento:

        var sb = (Storyboard)FindResource("AmbientSb");
        sb.Begin(Backdrop, Backdrop.Template, isControllable: true);   // Loaded
        sb.Stop(Backdrop); sb.Remove(Backdrop);                        // Closed  (obrigatório)

    Cor da marca (opcional): o template lê três pincéis do próprio Control —
        Background  = wash radial A     (RadialGradientBrush montado em C#)
        BorderBrush = wash radial B
        Foreground  = cor das trilhas   (SolidColorBrush)
    Basta atribuí-los e animá-los; o template não precisa de FindName.

    O gesto: arcos concêntricos gigantes ("trilhas de disco") girando em torno de
    dois centros FORA da tela. Só RotateTransform/TranslateTransform/ScaleTransform —
    nenhuma animação de layout, nenhum blur animado. Velocidade tangencial de
    60 a 155 px/s: dá para VER o movimento em ~2 s.

    Todos os períodos dividem 120 s, então o conjunto tem período comum de 120 s
    e PreviewSeek(0) == PreviewSeek(1) de verdade.
    ================================================================================ -->
    <ControlTemplate x:Key="AmbientBackdrop" TargetType="Control">
        <Grid ClipToBounds="True">
            <Rectangle Fill="{DynamicResource AppSurfaceGradient}"/>

            <!-- INTENSIDADE. Tudo o que se MEXE mora dentro de "AmbientLayer"; o
                 gradiente de página fica FORA dele. Assim dá para baixar o volume
                 do movimento sem lavar a cor de fundo da tela:

                     Backdrop.ApplyTemplate();
                     ((FrameworkElement)Backdrop.Template.FindName("AmbientLayer", Backdrop))
                         .Opacity = 0.42;   // tela de trabalho

                 Sem mexer, fica em 1 — que é o que a tela de seleção usa. -->
            <Grid x:Name="AmbientLayer">

            <!-- Washes na cor da marca (Fill vem do Control: animável em C#) -->
            <Ellipse x:Name="WashA" Width="1460" Height="1460" Fill="{TemplateBinding Background}"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-470,-540,0,0"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="WashAS" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="WashAT"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="WashB" Width="1180" Height="1180" Fill="{TemplateBinding BorderBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-330,-430"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="WashBS" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="WashBT"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- ===== TRILHAS DA ESQUERDA =====
                 Canvas de 0x0: é só um PONTO de ancoragem. Os filhos saem dele
                 para fora (Canvas não recorta), então o centro de rotação fica
                 fora da janela e só o arco atravessa a tela. -->
            <Canvas Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="-300,0,0,0">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="DriftL"/>
                </Canvas.RenderTransform>

                <!-- horário, 120 s -->
                <Canvas Width="0" Height="0">
                    <Canvas.CacheMode><BitmapCache RenderAtScale="0.5" EnableClearType="False"/></Canvas.CacheMode>
                    <Canvas.RenderTransform><RotateTransform x:Name="TrackA" Angle="0"/></Canvas.RenderTransform>
                    <!-- FEIXES: arcos MUITO grossos e translúcidos. São eles que dão
                         movimento de área grande (o olho pega a banda inteira
                         deslizando); os arcos finos e os nós dão o movimento de
                         detalhe. O tracejado é o que impede um anel uniforme de
                         girar sem que nada pareça mudar. -->
                    <Ellipse Canvas.Left="-1780" Canvas.Top="-1780" Width="3560" Height="3560"
                             Stroke="{TemplateBinding Foreground}" StrokeThickness="300" Opacity="0.11"
                             StrokeDashArray="4.6 6.4" StrokeDashCap="Round"/>
                    <Ellipse Canvas.Left="-1150" Canvas.Top="-1150" Width="2300" Height="2300"
                             Stroke="{TemplateBinding Foreground}" StrokeThickness="200" Opacity="0.08"
                             StrokeDashArray="5.2 7.8" StrokeDashCap="Round"/>
                    <Ellipse Canvas.Left="-2260" Canvas.Top="-2260" Width="4520" Height="4520"
                             Stroke="{TemplateBinding Foreground}" StrokeThickness="3" Opacity="0.42"
                             StrokeDashArray="0.5 11" StrokeDashCap="Round"/>
                    <Ellipse Canvas.Left="-2060" Canvas.Top="-2060" Width="4120" Height="4120"
                             Stroke="{TemplateBinding Foreground}" StrokeThickness="2.6" Opacity="0.55"
                             StrokeDashArray="52 30" StrokeDashCap="Round"/>
                    <Ellipse Canvas.Left="-1860" Canvas.Top="-1860" Width="3720" Height="3720"
                             Stroke="{DynamicResource AmbientLine}" StrokeThickness="1.6"/>
                    <Ellipse Canvas.Left="-1680" Canvas.Top="-1680" Width="3360" Height="3360"
                             Stroke="{DynamicResource AmbientLine}" StrokeThickness="2"
